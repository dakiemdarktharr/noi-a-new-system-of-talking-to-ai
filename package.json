{
  "name": "noi-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:browser": "node qa/integration.mjs && node qa/accessibility.mjs && node qa/meaning-graph.mjs",
    "test:graph": "node qa/meaning-graph.mjs",
    "test:sync": "node qa/server-import.mjs && node qa/workspace-sync.mjs && node qa/archive-reload.mjs && node qa/cloud-label-race.mjs",
    "test:flows": "node qa/meaning-dataset.mjs && node qa/catalog-progress.mjs && node qa/motion-recognition.mjs && node qa/two-hand-tracker.mjs",
    "test:production": "node qa/production-smoke.mjs",
    "assets": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@huggingface/hub": "^2.17.10",
    "@mediapipe/tasks-vision": "^1.2.2",
    "@tensorflow/tfjs": "^4.22.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
